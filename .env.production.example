# Copy to .env.production and replace EVERY value. The API refuses to start in production if a
# secret is a placeholder, shorter than 32 characters, or the two JWT secrets are equal.
# Generate each secret with:  openssl rand -base64 48
# Never commit .env.production.

# Database owner (migrations and approved maintenance only) and the API's least-privilege role.
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Encrypts authenticator-app secrets in the database. Must differ from the JWT secrets. Keep it safe
# with the backups: losing it means every person must set up their authenticator again.
MFA_ENCRYPTION_KEY=
# privileged (default): approvers and administrators must use an authenticator app; all: everyone.
# MFA_ENFORCEMENT=privileged

# The public HTTPS address people use, exactly as typed in the browser (no trailing slash).
FRONTEND_ORIGIN=https://receivables.hospital-domain.example

# Private object storage for uploaded source files: any S3-compatible service. Defaults point at the
# optional bundled MinIO container (profile "bundled-storage", which also needs MINIO_IMAGE pinned).
# For a hosted service set MINIO_ENDPOINT (host name only), MINIO_PORT (usually 443) and MINIO_USE_SSL=true.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# MINIO_ENDPOINT=
# MINIO_PORT=
# MINIO_USE_SSL=
# MINIO_BUCKET=hnb-private
# MINIO_IMAGE=
