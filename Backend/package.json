{
    "name": "hnb-backend",
    "version": "0.1.0",
    "private": true,
    "description": "HNB-Receivables Management Platform API",
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:prod": "node dist/main.js",
        "lint": "eslint \"{src,prisma,test}/**/*.ts\"",
        "typecheck": "tsc --noEmit",
        "test": "jest",
        "test:e2e": "jest --config ./test/jest-e2e.json --passWithNoTests",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:deploy": "prisma migrate deploy",
        "prisma:studio": "prisma studio",
        "seed": "ts-node prisma/seed.ts"
    },
    "prisma": {
        "seed": "ts-node prisma/seed.ts"
    },
    "dependencies": {
        "@nestjs/bullmq": "11.0.5",
        "@nestjs/common": "11.2.8",
        "@nestjs/config": "4.0.4",
        "@nestjs/core": "11.2.8",
        "@nestjs/jwt": "11.0.2",
        "@nestjs/passport": "11.0.5",
        "@nestjs/platform-express": "11.2.8",
        "@nestjs/swagger": "^11.4.8",
        "@nestjs/throttler": "6.5.0",
        "@prisma/client": "6.19.3",
        "argon2": "0.44.0",
        "bullmq": "5.81.5",
        "class-transformer": "0.5.1",
        "class-validator": "0.14.2",
        "cookie-parser": "1.4.7",
        "csv-parse": "7.0.3",
        "decimal.js": "10.6.0",
        "helmet": "8.1.0",
        "minio": "8.0.7",
        "nodemailer": "10.2.1",
        "passport": "0.7.0",
        "passport-jwt": "4.0.1",
        "pdf-parse": "1.1.1",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "swagger-ui-express": "5.0.1",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
    },
    "devDependencies": {
        "@eslint/js": "9.36.0",
        "@nestjs/cli": "11.0.24",
        "@nestjs/schematics": "11.1.0",
        "@nestjs/testing": "11.2.8",
        "@types/cookie-parser": "1.4.9",
        "@types/express": "5.0.3",
        "@types/jest": "29.5.14",
        "@types/multer": "2.0.0",
        "@types/node": "24.5.2",
        "@types/nodemailer": "8.0.2",
        "@types/passport-jwt": "4.0.1",
        "@types/pdf-parse": "1.1.5",
        "@types/supertest": "6.0.3",
        "eslint": "9.36.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.4",
        "jest": "29.7.0",
        "prettier": "3.6.2",
        "prisma": "6.19.3",
        "supertest": "7.1.4",
        "ts-jest": "29.4.4",
        "ts-loader": "9.5.4",
        "ts-node": "10.9.2",
        "tsconfig-paths": "4.2.0",
        "typescript": "5.9.3",
        "typescript-eslint": "8.44.1"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "allowScripts": {
        "argon2": true,
        "msgpackr-extract": true,
        "prisma": true,
        "@prisma/client": true,
        "@prisma/engines": true,
        "@scarf/scarf": true
    },
    "overrides": {
        "multer": "2.5.0"
    }
}
