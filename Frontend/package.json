{
    "name": "hnb-frontend",
    "version": "0.1.0",
    "private": true,
    "description": "HNB-Receivables Management Platform web app",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@tanstack/react-query": "5.76.0",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-router-dom": "7.18.4"
    },
    "devDependencies": {
        "@tailwindcss/vite": "4.1.7",
        "@testing-library/jest-dom": "6.6.3",
        "@testing-library/react": "16.3.0",
        "@testing-library/user-event": "14.6.1",
        "@types/react": "19.1.4",
        "@types/react-dom": "19.1.5",
        "@vitejs/plugin-react": "4.5.0",
        "jsdom": "26.1.0",
        "tailwindcss": "4.1.7",
        "typescript": "5.9.3",
        "vite": "6.4.5",
        "vitest": "4.1.12"
    },
    "allowScripts": {
        "esbuild": true,
        "@tailwindcss/oxide": true
    }
